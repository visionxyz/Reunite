EVERMEMOS_API_KEY=your-evermemos-api-key-here

# AI assistant — uses OpenRouter by default (OpenAI-compatible).
# Set OPENROUTER_API_KEY to use OpenRouter, or fall back to OPENAI_API_KEY for direct OpenAI.
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Optional: override the model. Defaults to "openai/gpt-4o-mini" on OpenRouter, "gpt-4o-mini" on OpenAI.
# OPENAI_MODEL=openai/gpt-4o-mini
